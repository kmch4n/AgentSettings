{
    "ehs208-timetree-mcp": {
        "type": "stdio",
        "command": "npx",
        "args": [
            "--no-install",
            "timetree-mcp"
        ],
        "env": {
            "TIMETREE_EMAIL": "${TIMETREE_EMAIL}",
            "TIMETREE_PASSWORD": "${TIMETREE_PASSWORD}"
        }
    },
    "gmail": {
        "type": "stdio",
        "command": "npx",
        "args": [
            "-y",
            "@gongrzhe/server-gmail-autoauth-mcp"
        ]
    },
    "github": {
        "type": "http",
        "url": "https://api.githubcopilot.com/mcp/",
        "headers": {
            "Authorization": "Bearer ${GITHUB_PERSONAL_ACCESS_TOKEN}"
        }
    }
}
